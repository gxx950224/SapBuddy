{
  "name": "sapbuddy",
  "version": "1.0.2",
  "description": "SAP ABAP AI 全能助手（面向开发顾问与业务顾问）— 用自然语言驱动 42 个 SAP 工具（CLI + Web）",
  "type": "module",
  "main": "cli.mjs",
  "bin": {
    "sapbuddy": "cli.mjs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node cli.mjs",
    "chat": "node cli.mjs chat",
    "web": "node cli.mjs web",
    "tools": "node cli.mjs tools",
    "doctor": "node cli.mjs doctor",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build",
    "test": "node --test",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sap",
    "abap",
    "ai",
    "assistant",
    "adt",
    "cli",
    "copilot",
    "consultant",
    "business"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "abap-adt-api": "^8.4.1",
    "typebox": "^1.3.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "SapBuddy Contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxx950224/sapbuddy.git"
  },
  "homepage": "https://github.com/gxx950224/sapbuddy#readme",
  "files": [
    "cli.mjs",
    "src/",
    "dist/",
    "config/",
    "docs/",
    "test/",
    "defaults/",
    "README.md",
    "LICENSE",
    "CREDITS.md",
    "AGENTS.md",
    "SYSTEM.md",
    "Memory.md",
    "CONTRIBUTING.md"
  ],
  "bugs": {
    "url": "https://github.com/gxx950224/sapbuddy/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}