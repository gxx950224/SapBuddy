{
  "name": "sapbuddy",
  "version": "1.0.0",
  "description": "SAP ABAP AI 全能助手（面向开发顾问与业务顾问）— 用自然语言驱动 42 个 SAP 工具（CLI + Web）",
  "type": "module",
  "main": "cli.mjs",
  "bin": {
    "sapbuddy": "cli.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build-copy.mjs && node scripts/obfuscate.mjs",
    "start": "node cli.mjs",
    "chat": "node cli.mjs chat",
    "web": "node cli.mjs web",
    "tools": "node cli.mjs tools",
    "doctor": "node cli.mjs doctor",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test",
    "check": "tsc --noEmit",
    "obfuscate": "node scripts/obfuscate.mjs"
  },
  "keywords": [
    "sap",
    "abap",
    "ai",
    "assistant",
    "adt",
    "cli",
    "copilot",
    "consultant",
    "business"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "abap-adt-api": "^8.4.1",
    "typebox": "^1.3.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "javascript-obfuscator": "^5.5.0",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "SapBuddy Contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourname/sapbuddy.git"
  },
  "homepage": "https://github.com/yourname/sapbuddy#readme",
  "files": [
    "cli.mjs",
    "dist/",
    "config/",
    "docs/",
    "test/",
    ".SapBuddy/prompts/",
    ".SapBuddy/skills/",
    ".SapBuddy/models.json",
    "README.md",
    "LICENSE",
    "CREDITS.md",
    "AGENTS.md",
    "SYSTEM.md",
    "Memory.md",
    "CONTRIBUTING.md"
  ]
}