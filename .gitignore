# 依赖
node_modules/
package-lock.json

# 编译产物：只提交混淆后的扩展代码（GitHub 加密）；可读源码与类型定义不入库
# src/sap-tools（TS 源码，含安全/工具实现细节）不入库
src/sap-tools/
src/agent-core.mjs
# dist：仅混淆产物入库（.js/.mjs），类型定义/映射文件排除
dist/*
!dist/sap-tools/
!dist/agent-core.mjs
dist/sap-tools/**/*.d.ts
dist/sap-tools/**/*.map
dist/**/*.d.ts
dist/**/*.map
!dist/sap-tools/**/*.js
!dist/sap-tools/**/*.mjs

# 日志与临时
*.log
*.pid
.DS_Store
Thumbs.db

# 用户运行时配置（含敏感信息，不提交）
# .SapBuddy/skills、prompts、models.json 为默认内容随仓库跟踪；个人文件忽略
.SapBuddy/auth.json
.SapBuddy/settings.json
.SapBuddy/connections.json
.SapBuddy/sessions/
.SapBuddy/output/
.SapBuddy/mcp.json
.SapBuddy/memory.md
.SapBuddy/models-store.json
.SapBuddy/agent

# 旧版 .pi 配置目录（已废弃，git 内容迁移到 .SapBuddy 后整个忽略）
.pi/

# 旧版项目根产物与连接（已迁移到 .SapBuddy，防误提交）
output/
connections.json
.SapBuddy/sessions-test/
.SapBuddy/uploads/
.tmp_*
deliverables/
*.abap
