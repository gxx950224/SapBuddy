# 依赖
node_modules/
package-lock.json

# 编译产物（开源：源码入库，dist 由 npm run build 生成，不提交）
dist/

# 日志与临时
*.log
*.pid
.DS_Store
Thumbs.db

# 本机 Claude Code 配置（不入库）
.claude/

# 其他 AI 助手本地目录（不入库）
.workbuddy/

# 用户运行时配置（含敏感信息，不提交）
# 默认技能/models.json 已随仓库放在 defaults/，运行时由 ensureRuntimeFiles 拷贝到 .SapBuddy/
.SapBuddy/auth.json
.SapBuddy/settings.json
.SapBuddy/connections.json
.SapBuddy/sessions/
.SapBuddy/output/
.SapBuddy/mcp.json
.SapBuddy/memory.md
.SapBuddy/models-store.json
.SapBuddy/agent
.SapBuddy/skills/
.SapBuddy/models.json

# 旧版 .pi 配置目录（已废弃，git 内容迁移到 .SapBuddy 后整个忽略）
.pi/

# 旧版项目根产物与连接（已迁移到 .SapBuddy，防误提交）
output/
connections.json
.SapBuddy/sessions-test/
.SapBuddy/uploads/
.tmp_*
deliverables/
*.abap

# 平台二进制（fd/rg，随 npm 包分发但不入库；cli.mjs 启动时按系统自动选择复制到 .SapBuddy/bin）
.SapBuddy/bin/
binaries/

# 遗留镜像目录（含敏感配置，整体忽略）
.SapBuddy/prompts/
